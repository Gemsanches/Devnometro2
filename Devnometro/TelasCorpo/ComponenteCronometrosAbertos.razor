@inherits ComponenteCronometrosAbertosBase

<MudBadge Color="Color.Secondary"
          BadgeClass="rounded-3 rounded-b-0 gray lighten-4 py-n1 pointer-events-none"
          Bordered="false"
          Content=@string.Concat("Trabalhos ","em andamento")
          Overlap="true"
          Origin="Origin.TopCenter"
          Class="pa-0 mt-2">
    <MudContainer Style="max-height:59px; min-height:59px; overflow-y:hidden; overflow-x:hidden;">
        <MudPaper Width="267px" Height="50px" Class="pt-2 mb-0 mt-2 mx-n2 mud-theme-secondary">
            <MudStack Row>
                <MudPaper Width="202px" Height="42px" Elevation="3"
                          Class="pa-0 mt-n1 ml-2 mud-theme-primary"
                          Style="overflow-x:scroll; overflow-y:hidden;">
                    <MudButtonGroup Color="Color.Primary" Variant="Variant.Filled" OverrideStyles="true"
                                    Class="pa-0 ma-0"
                                    Style="max-height:30px; min-height:30px;">
                        <MudButton Class="pa-0 ma-0 border-1"
                                   Style="max-width:60px; min-width:60px;">102520</MudButton>
                        <MudButton Class="pa-0 ma-0"
                                   Style="max-width:60px; min-width:60px;">154</MudButton>
                        <MudButton Class="pa-0 ma-0"
                                   Style="max-width:60px; min-width:60px;">10256</MudButton>
                        <MudButton Class="pa-0 ma-0"
                                   Style="max-width:60px; min-width:60px;">10257</MudButton>
                        <MudButton Class="pa-0 ma-0"
                                   Style="max-width:60px; min-width:60px;">10258</MudButton>
                        <MudButton Class="pa-0 ma-0"
                                   Style="max-width:60px; min-width:60px;">10262</MudButton>
                    </MudButtonGroup>
                </MudPaper>
                <MudPaper Width="32px" Height="42px" Elevation="3"
                          Class="pa-0 mt-n1 ml-2 mud-theme-primary d-flex justify-center">
                    <MudToggleIconButton @bind-Toggled="MostrarDrawer"
                                         Class="pa-0 ma-0"
                                         Size="Size.Large"
                                         Icon="@Icons.Material.Filled.Compress"
                                         Color="@Color.Info"
                                         ToggledIcon="@Icons.Material.Filled.Expand"
                                         ToggledColor="@Color.Info" />
                </MudPaper>
            </MudStack>
        </MudPaper>
    </MudContainer>
</MudBadge>

<MudDrawer @bind-Open="@MostrarDrawer"
           Anchor="Anchor.Top"
           Height="196px"
           Elevation="3"
           Class="pa-2 mud-theme-primary"
           Variant="@DrawerVariant.Temporary"
           Overlay="false">
    <p>CRUD cronometro aberto</p>
</MudDrawer>

<MudDrawer @bind-Open="@MostrarDrawer"
           Anchor="Anchor.Bottom"
           Height="294px"
           Elevation="3"
           Class="pa-2 mud-theme-primary"
           Variant="@DrawerVariant.Temporary"
           Overlay="false">
    <p>Lista/Cards com detalhes de cada cronomêtro aberto</p>
</MudDrawer>