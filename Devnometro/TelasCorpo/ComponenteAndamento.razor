@inherits ComponenteAndamentoBase

<MudContainer Class="py-0 px-2 mt-n1"
              Style="max-height:300px; min-height:300px; overflow-y:scroll; overflow-x:hidden;">
    <MudPaper Width="274px" MinHeight="300px"
              Class="pt-2 px-0 mb-0 mt-0 mx-n2 mud-theme-tertiary rounded-0">
        <MudStack Row>
            <MudPaper Width="259px" Height="42px" Elevation="3"
                      Class="pa-0 mt-n1 ml-2 mud-theme-primary cursor-pointer"
                      onclick="@(() => {MostrarDrawer = !MostrarDrawer;})">
                <MudText Class="pa-0 d-flex align-center justify-center">CH:102520 | OC:10045</MudText>
                <MudText Class="pa-0 mt-n1 ml-1">Título do caso ou descrição</MudText>
            </MudPaper>
        </MudStack>
    </MudPaper>
</MudContainer>

<MudDrawer @bind-Open="@MostrarDrawer"
           Anchor="Anchor.Top"
           Height="261px"
           Elevation="3"
           Class="pa-2 mud-theme-primary"
           Variant="@DrawerVariant.Temporary"
           Overlay="false">
    <p>...</p>
</MudDrawer>