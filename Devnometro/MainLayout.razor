@inherits LayoutComponentBase
@inject Preferencias preferencias
@using Devnometro.Dominio
@using Devnometro.Aplicacao

<MudThemeProvider DefaultScrollbar="false"
                  @bind-IsDarkMode="@preferencias.TemaNoturno"
                  Theme="preferencias.Tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Dense="true" Color="Color.Tertiary" Elevation="2" Class="ma-0">
        <MudButtonGroup Variant="Variant.Filled" Color="Color.Dark">
            <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom" Class="ml-20">
                <ChildContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Save" Size="Size.Small"
                                   @onmouseover='() => AplicarMensagem("Salvar")'
                                   @onmouseleave="ResetarMensagem"
                                   OnClick="Salvar" />
                </ChildContent>
                <TooltipContent>
                    <MudText Typo="Typo.h5"><MudIcon Icon="@Icons.Material.Outlined.Save" /> Salvar <MudIcon Icon="@Icons.Material.Outlined.Save" /></MudText>
                    <MudText Typo="Typo.body2">O Devnômetro, por padrão, salva</MudText>
                    <MudText Typo="Typo.body2">automáticamente. Mas você pode</MudText>
                    <MudText Typo="Typo.body2">salvar manualmente apertando</MudText>
                    <MudText Typo="Typo.body2">esse botão.</MudText>
                </TooltipContent>
            </MudTooltip>
            <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom" Class="ml-11">
                <ChildContent>
                    <MudIconButton Icon="@Icons.Material.Filled.HourglassDisabled" Size="Size.Small"
                                   @onmouseover='() => AplicarMensagem("Parar Tudo")'
                                   @onmouseleave="ResetarMensagem" />
                </ChildContent>
                <TooltipContent>
                    <MudText Typo="Typo.h5"><MudIcon Icon="@Icons.Material.Outlined.HourglassDisabled" /> Parar Tudo <MudIcon Icon="@Icons.Material.Outlined.HourglassDisabled" /></MudText>
                    <MudText Typo="Typo.body2">Interrompe todos os contadores</MudText>
                    <MudText Typo="Typo.body2">ativos, sem ativar interrupções</MudText>
                    <MudText Typo="Typo.body2">ou iniciar rotina de finalização</MudText>
                    <MudText Typo="Typo.body2">(tempo deixará de ser contado).</MudText>
                </TooltipContent>
            </MudTooltip>
            <MudButton Class="cursor-default" Style="width:108px" Disabled="true">
                <MudText Color="Color.Warning" Typo="Typo.subtitle2">@mensagem</MudText>
            </MudButton>
            <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom" Class="ml-n20">
                <ChildContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   @onmouseover='() => AplicarMensagem("Menu")'
                                   @onmouseleave="ResetarMensagem"
                                   OnClick="AbrirMenu"
                                   Disabled="@janelaMenu.IsLoaded" />
                </ChildContent>
                <TooltipContent>
                    <MudText Typo="Typo.h5"><MudIcon Icon="@Icons.Material.Outlined.Menu" /> Menu <MudIcon Icon="@Icons.Material.Outlined.Menu" /></MudText>
                    <MudText Typo="Typo.body2">Abre o menu de opções:</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Start">Exportações - Exporte os dados</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Start">Configurações - Opções gerais</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Start">Tema - Ajuste a aparência</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Start">Cadastro - Ajuste a aparência</MudText>
                </TooltipContent>
            </MudTooltip>
        </MudButtonGroup>
    </MudAppBar>
    <MudMainContent>
        <MudPaper Square=true Class="pa-0 ma-0 mud-theme-surface">
            <Devnometro.TelasCorpo.ComponentePonto />
            <Devnometro.TelasCorpo.ComponenteTarefasRapidas />
            <Devnometro.TelasCorpo.ComponenteCronometrosAbertos />
            <Devnometro.TelasCorpo.ComponenteAndamento />
        </MudPaper>
    </MudMainContent>
</MudLayout>

@code
{
    private string diaDeHoje = string.Empty;
    private string mensagem = string.Empty;
    private ManipuladorDeArquivo manipulador = new();

    MenuWindow janelaMenu = null!;

    protected override void OnInitialized()
    {
        preferencias = ManipuladorDeArquivo.CarregarPreferencias();
        AcordarTema();
        preferencias.OnChanged += StateHasChanged;
        janelaMenu = new(preferencias);
        diaDeHoje = DateTime.Now.ToShortDateString();
        mensagem = diaDeHoje;
    }

    private void AcordarTema()
    {
        var temaTemp = preferencias.TemaSelecionado;
        preferencias.TemaSelecionado = Dominio.Enumeradores.ETema.TemaPadrao;
        preferencias.TemaSelecionado = temaTemp;
    }

    private void AplicarMensagem(string texto)
    {
        mensagem = texto;
        StateHasChanged();
    }

    private void ResetarMensagem()
    {
        mensagem = diaDeHoje;
        StateHasChanged();
    }

    private void AbrirMenu()
    {
        if (janelaMenu.IsLoaded)
        {
            janelaMenu.BringIntoView();
            janelaMenu.Focus();
            return;
        }
        janelaMenu = new(preferencias);
        janelaMenu.AplicaAlteracoes += ReplicaAlteracoes;
        janelaMenu.Show();
    }
    private void ReplicaAlteracoes(object? sender, EventArgs e)
    {
        preferencias.TemaNoturno = !preferencias.TemaNoturno;
        StateHasChanged();
    }

    private async Task Salvar() => await manipulador.SalvarPreferenciasAsync(preferencias);

}