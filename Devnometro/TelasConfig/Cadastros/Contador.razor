@inherits ContadorBase

<MudPaper MaxHeight="460px" Class="pt-1">
    <MudDataGrid T="Dominio.Contador"
                 MultiSelection="false"
                 Items="@Model"
                 SortMode="SortMode.Single"
                 QuickFilter="@Filtrar"
                 Dense="true"
                 Striped="false"
                 Hover="true"
                 EditMode="DataGridEditMode.Form"
                 Filterable="false"
                 Hideable="false"
                 Style="min-height:440px">
        <ToolBarContent>
            <MudText Typo="Typo.h6" Class="pointer-events-none py-n3">Contadores</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="textoConsulta"
                          Placeholder="Pesquisar"
                          Adornment="Adornment.Start"
                          Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Small"
                          Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <TemplateColumn CellStyle="max-width: 40px;" >
                <CellTemplate>
                    <MudIcon Icon="@context.Item.Icone" Color="@context.Item.CorIcone" Class="py-n5 mt-n2 mb-n3" Style="font-size: 30px;" /> @*Style="font-size: 21px;"*@
                </CellTemplate>
            </TemplateColumn>
            <PropertyColumn Property="x => x.Nome" Title="Contador" CellStyle="min-width: 324px; max-width: 324px; overflow-x: hidden; white-space: nowrap;" />
            <PropertyColumn Property="x => x.ContaTempoString" Title="Atividade" Sortable="false" Filterable="false" />
            <TemplateColumn>
                <CellTemplate>
                    <MudStack Row>
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.TwoTone.RemoveRedEye"
                                       Color="@Color.Dark" />
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.TwoTone.Edit"
                                       Color="@Color.Dark" />
                        <MudIconButton Size="@Size.Small"
                                       Icon="@Icons.Material.TwoTone.Delete"
                                       Color="@Color.Dark" />
                    </MudStack>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <PagerContent>
            <MudStack Row>
                <MudIconButton Size="@Size.Small"
                               Icon="@Icons.Material.TwoTone.Add"
                               Color="@Color.Dark" 
                               Class="px-4" />
                <MudSwitch @bind-Value="@drawerAberto" Size="Size.Medium" />

                <MudSpacer />
                <MudDataGridPager T="Dominio.Contador"
                                  InfoFormat="{first_item}..{last_item} / {all_items}" 
                                  PageSizeOptions=[7]
                                  PageSizeSelector="false" />
            </MudStack>
        </PagerContent>
    </MudDataGrid>
</MudPaper>

<MudDrawer @bind-Open="@drawerAberto" Anchor="Anchor.Bottom" Height="400px" Elevation="1" Variant="@DrawerVariant.Temporary" OverlayAutoClose="true">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6">My App</MudText>
    </MudDrawerHeader>
    <MudIconButton OnClick=@(e=> SelcionarIcone(descricao:"Teste",cor:Color.Error,iconeAtual:@Icons.Material.Filled.Fullscreen)) Icon="@Icons.Material.Filled.Fullscreen" Color="@Color.Primary" ToggledIcon="@Icons.Material.Filled.FullscreenExit" ToggledColor="@Color.Secondary" />
</MudDrawer>
