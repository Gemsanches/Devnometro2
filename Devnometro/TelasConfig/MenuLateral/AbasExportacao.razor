<MudPaper Class="pa-0 ma-0 mt-n4 pt-4" Height="508px">
    <MudTabs Elevation="2"
             Rounded="true"
             Centered="true"
             Color="Color.Tertiary"
             IconColor="Color.Dark"
             MinimumTabWidth="20px">
        <MudTabPanel ToolTip="Ponto" Icon="@Icons.Material.TwoTone.Badge">
            <Devnometro.TelasConfig.Exportacoes.Ponto Preferencias="Preferencias" />
        </MudTabPanel>
        <MudTabPanel ToolTip="Tempos" Icon="@Icons.Material.TwoTone.AccessTime">
            <Devnometro.TelasConfig.Exportacoes.Tempo Preferencias="Preferencias" />
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    [Parameter] public required Devnometro.Dominio.Preferencias Preferencias { get; set; }
}
