<MudPaper Class="pa-0 ma-0 mt-n4 pt-4" Height="508px">
    <MudTabs Elevation="2"
             Rounded="true"
             Centered="true"
             Color="Color.Tertiary"
             IconColor="Color.Dark"
             MinimumTabWidth="20px">
        <MudTabPanel ToolTip="Contador" Icon="@Icons.Material.TwoTone.HourglassBottom">
            <Devnometro.TelasConfig.Cadastros.Contador Preferencias="Preferencias" />
        </MudTabPanel>
        <MudTabPanel ToolTip="Padrão de cronômetros" Icon="@Icons.Material.TwoTone.AutoMode">
            <Devnometro.TelasConfig.Cadastros.Padrao Preferencias="Preferencias" />
        </MudTabPanel>
        <MudTabPanel ToolTip="Tarefa Expressa" Icon="@Icons.Material.TwoTone.AlarmOn">
            <Devnometro.TelasConfig.Cadastros.Expresso Preferencias="Preferencias" />
        </MudTabPanel>
    </MudTabs>
</MudPaper>

@code {
    [Parameter]
    public required Devnometro.Dominio.Preferencias Preferencias { get; set; }
}
