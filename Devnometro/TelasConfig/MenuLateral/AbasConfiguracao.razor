<MudPaper Class="pa-0 ma-0 mt-n4 pt-4" MinHeight="508px">
    <MudTabs
        Elevation="2"
        Rounded="true"
        Centered="true"
        Color="Color.Tertiary"
        IconColor="Color.Dark"
        MinimumTabWidth="20px">
        <MudTabPanel ToolTip="Opções" Icon="@Icons.Material.TwoTone.Ballot">
            <Devnometro.TelasConfig.Configuracoes.Opcao />
        </MudTabPanel>
        <MudTabPanel ToolTip="Comunicação" Icon="@Icons.Material.TwoTone.Announcement">
            <Devnometro.TelasConfig.Configuracoes.Comunicacao />
        </MudTabPanel>
        <MudTabPanel ToolTip="Ajustes" Icon="@Icons.Material.TwoTone.Tune">
            <Devnometro.TelasConfig.Configuracoes.Ajuste />
        </MudTabPanel>
        <MudTabPanel ToolTip="Caminhos" Icon="@Icons.Material.TwoTone.Folder">
            <Devnometro.TelasConfig.Configuracoes.Caminho />
        </MudTabPanel>
        <MudTabPanel ToolTip="Atalhos" Icon="@Icons.Material.TwoTone.Keyboard">
            <Devnometro.TelasConfig.Configuracoes.Atalho />
        </MudTabPanel>
    </MudTabs>
</MudPaper>

