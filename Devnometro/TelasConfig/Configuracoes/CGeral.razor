@using Devnometro.Dominio
@using Devnometro.Aplicacao
@inherits CGeralBase

<MudPaper Class="pa-0 ma-3" Elevation="3" MaxWidth="575px">
    <MudText Typo="Typo.h6" Class="pa-0 mx-3 pointer-events-none" Color="Color.Dark">Inicialização</MudText>
    <MudDivider />
    <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom" Class="ml-20">
        <ChildContent>
            <MudCheckBox @bind-Value="Preferencias.Geral.LigarJunto" Class="my-n2" Label="Ligar junto do computador"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Tentar registrar o Devnômetro para ligar</MudText>
            <MudText Typo="Typo.body2">automaticamente com o computador</MudText>
            <MudText Typo="Typo.body2">(dependente do Sistema Operacional)</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline">@MetodosEstaticos.BooleanoSimNao(PrefereciaPadrao.LigarJunto)</MudText>
        </TooltipContent>
    </MudTooltip>
</MudPaper>

<MudPaper Class="pa-0 ma-3" Elevation="3" MaxWidth="575px">
    <MudText Typo="Typo.h6" Class="pa-0 mx-3 pointer-events-none" Color="Color.Dark">Exibição</MudText>
    <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom"  Class="ml-20">
        <ChildContent>
            <MudRadioGroup Class="ml-3 mb-1" @bind-Value="Preferencias.Geral.Exibicao">
                <MudRadio Value=1 Color="Color.Primary" Size="Size.Small" Dense="true">Compacta</MudRadio>
                <MudRadio Value=2 Color="Color.Primary" Size="Size.Small" Dense="true">Normal</MudRadio>
                <MudRadio Value=3 Color="Color.Primary" Size="Size.Small" Dense="true">Expandida</MudRadio>
                <MudRadio Value=4 Color="Color.Primary" Size="Size.Small" Dense="true">Legendada</MudRadio>
            </MudRadioGroup>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Regula a quantidade de informação</MudText>
            <MudText Typo="Typo.body2">a ser exibida nos cronômetros</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline">@DescricaoExibicao(PrefereciaPadrao.Exibicao)</MudText>
        </TooltipContent>
    </MudTooltip>
</MudPaper>

<MudPaper Class="pa-0 pb-1 ma-3" Elevation="3" MaxWidth="575px">
    <MudText Typo="Typo.h6" Class="pa-0 mx-3 pointer-events-none" Color="Color.Dark">Salvamento automático</MudText>
    <MudDivider />
    <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom"  Class="ml-20">
        <ChildContent>
            <MudCheckBox @bind-Value="Preferencias.AutoSave.Ativo" Class="my-n2" Label="Habilitar salvamento automático"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline">@MetodosEstaticos.BooleanoSimNao(PrefereciaPadrao.AutoSave)</MudText>
        </TooltipContent>
    </MudTooltip>
    <MudDivider />
    <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom"  Class="ml-20">
        <ChildContent>
            <MudGrid>
                <MudItem xl="10" lg="10" md="10" sm="10">
                    <MudSlider T="int" Min="1" Max="60" Value="@Preferencias.AutoSave.Tempo" ValueChanged="@(x=>AjustadoPeloSlider(x))" Class="pa-0 mx-3" Size="Size.Medium">Tempo entre salvamentos automáticos (em minutos)</MudSlider>
                </MudItem>
                <MudItem xl="2" lg="2" md="2" sm="2">
                    <MudNumericField Min="1" Max="60" Variant="Variant.Text" @bind-Value="Preferencias.AutoSave.Tempo" Class="mt-5 mr-4" />
                </MudItem>
            </MudGrid>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline">@PrefereciaPadrao.AutoSaveTempo min.</MudText>
        </TooltipContent>
    </MudTooltip>
    <MudPaper Class="pa-0 ma-3" Elevation="3">
        <MudText Typo="Typo.input" Class="pa-0 mx-3 pointer-events-none" Style="font-weight:bold" Color="Color.Dark">Salvar automaticamente quando:</MudText>
        <MudDivider />
        <MudGrid>
            <MudItem xl="6" lg="6" md="6" sm="6">
                <MudCheckBox @bind-Value="Preferencias.AutoSave.MarcarPonto" Class="my-n2" Label="Marcar ponto"></MudCheckBox>
                <MudCheckBox @bind-Value="Preferencias.AutoSave.EditarPonto" Class="my-n2" Label="Editar ponto"></MudCheckBox>
                <MudCheckBox @bind-Value="Preferencias.AutoSave.ExcluirPonto" Class="my-n2" Label="Excluir ponto"></MudCheckBox>
                <MudCheckBox @bind-Value="Preferencias.AutoSave.AbandonarCronometro" Class="my-n2" Label="Abandonar cronômetro"></MudCheckBox>
            </MudItem>
            <MudItem xl="6" lg="6" md="6" sm="6">
                <MudCheckBox @bind-Value="Preferencias.AutoSave.CriarCronometro" Class="my-n2" Label="Criar cronômetro"></MudCheckBox>
                <MudCheckBox @bind-Value="Preferencias.AutoSave.EditarCronometro" Class="my-n2" Label="Editar cronômetro"></MudCheckBox>
                <MudCheckBox @bind-Value="Preferencias.AutoSave.ExcluirCronometro" Class="my-n2" Label="Excluir cronômetro"></MudCheckBox>
                <MudCheckBox @bind-Value="Preferencias.AutoSave.FinalizarCronometro" Class="my-n2" Label="Finalizar cronômetro"></MudCheckBox>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudPaper>

<MudPaper Class="pa-0 ma-3" Elevation="3" MaxWidth="575px">
    <MudText Typo="Typo.h6" Class="pa-0 mx-3 pointer-events-none" Color="Color.Dark">Caminhos externos</MudText>
    <MudDivider />
    <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom"  Class="ml-20">
        <ChildContent>
            <MudTextField @bind-Value="Preferencias.Geral.CaminhoAtendimento" Label="Atendimento" AdornmentIcon="@Icons.Material.TwoTone.SupportAgent" Adornment="Adornment.Start" Margin="Margin.Dense" Variant="Variant.Text" Style="width:550px"></MudTextField>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Caminho que precede o número do chamado</MudText>
            <MudText Typo="Typo.body2">(permitindo um link válido de acesso)</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline">@PrefereciaPadrao.CaminhoAtendimento</MudText>
        </TooltipContent>
    </MudTooltip>
    <MudDivider />
    <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom"  Class="ml-20">
        <ChildContent>
            <MudTextField @bind-Value="Preferencias.Geral.CaminhoDesenvolvimento" Label="Desenvolvimento" AdornmentIcon="@Icons.Material.TwoTone.LogoDev" Adornment="Adornment.Start" Margin="Margin.Dense" Variant="Variant.Text" Style="width:550px"></MudTextField>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Caminho que precede o número da 'Order of Change'</MudText>
            <MudText Typo="Typo.body2">(permitindo um link válido de acesso)</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline">@PrefereciaPadrao.CaminhoDesenvolvimento</MudText>
        </TooltipContent>
    </MudTooltip>
</MudPaper>

<MudPaper Class="px-0 pt-3 pb-1 ma-3" Elevation="3" MaxWidth="575px">
    <MudGrid>
        <MudItem xl="8" lg="8" md="8" sm="8">
            <MudText Typo="Typo.h6" Class="pa-0 mx-3 pointer-events-none" Color="Color.Dark">Excluir dados</MudText>
        </MudItem>
        <MudItem xl="4" lg="4" md="4" sm="4">
            <MudBadge Content="@ContadorDestravar"
            Color="@CorContador"
            Overlap="true"
            Bordered="false"
            Class="mx-6 my-4">
                <MudButton Color="Color.Error" 
                Variant="Variant.Filled"
                DropShadow="true" 
                Size="Size.Small"
                Class="ma-0 py-0 px-2"
                Disabled="Destravado"
                OnClick="Destravar">Destravar</MudButton>
            </MudBadge>
        </MudItem>
    </MudGrid>
    @if (Destravado)
    {
        <MudDivider />
        <MudPaper Class="pa-0 ma-3" Elevation="3">
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true"
                       OnClick="ExcluirTemaPersonalizado">Excluir Tema Personalizado</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true">Excluir Configurações</MudButton>
            <MudDivider Class="pa-1" />
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true">Excluir Histórico de Ponto</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true">Excluir Histórico de Tempos</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true">Excluir Cronômetros Abertos</MudButton>
            <MudDivider Class="pa-1" />
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true">Excluir Cadastros de Contadores</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true">Excluir Cadastros de Padrões</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true">Excluir Cadastros de Expressos</MudButton>
        </MudPaper>
    }
    
</MudPaper>

<MudDivider Class="my-3" />
<MudButton Class="ma-3 px-3 py-1"
Style="float:right"
Variant="Variant.Filled"
Color="Color.Secondary"
OnClick="RestauraPadroes"
Disabled="EstaNosPadroes"
StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
IconColor="Color.Dark">
    Restaurar padrões
</MudButton>
