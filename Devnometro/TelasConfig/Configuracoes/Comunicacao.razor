<MudDivider Class="my-3" />

<MudButton Class="ma-3 px-3 py-1"
Style="float:right"
Variant="Variant.Filled"
Color="Color.Secondary"
OnClick="RestauraPadroes"
Disabled="EstaNosPadroes"
StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
IconColor="Color.Dark">
    Restaurar padrões
</MudButton>

@code {
    [Parameter]
    public required Devnometro.Dominio.Preferencias Preferencias { get; set; }

    #region Constantes
    private const bool padraoAvisarFecharPrograma = false;

    private const bool padraoAvisarIniciarExpotacaoPonto = false;
    private const bool padraoAvisarSucessoExpotacaoPonto = true;
    private const bool padraoAvisarIniciarExpotacaoTempo = false;
    private const bool padraoAvisarSucessoExpotacaoTempo = true;

    private const bool padraoAvisarIniciarCriacaoPonto = false;
    private const bool padraoAvisarSucessoCriacaoPonto = false;
    private const bool padraoAvisarIniciarExclusaoPonto = true;
    private const bool padraoAvisarSucessoExclusaoPonto = true;
    private const bool padraoAvisarIniciarEdicaoPonto = false;
    private const bool padraoAvisarSucessoEdicaoPonto = false;

    private const bool padraoAvisarIniciarCriacaoCronometro = false;
    private const bool padraoAvisarSucessoCriacaoCronometro = false;
    private const bool padraoAvisarIniciarExclusaoCronometro = false;
    private const bool padraoAvisarSucessoExclusaoCronometro = false;
    private const bool padraoAvisarIniciarEdicaoCronometro = false;
    private const bool padraoAvisarSucessoEdicaoCronometro = false;
    private const bool padraoAvisarIniciarAbandonoCronometro = true;
    private const bool padraoAvisarSucessoAbandonoCronometro = false;
    private const bool padraoAvisarIniciarFinalizacaoCronometro = false;
    private const bool padraoAvisarSucessoFinalizacaoCronometro = false;
    #endregion

    #region Propriedades
    private bool AvisarFecharPrograma { get; set; } = padraoAvisarFecharPrograma;

    private bool AvisarIniciarExpotacaoPonto { get; set; } = padraoAvisarIniciarExpotacaoPonto;
    private bool AvisarSucessoExpotacaoPonto { get; set; } = padraoAvisarSucessoExpotacaoPonto;
    private bool AvisarIniciarExpotacaoTempo { get; set; } = padraoAvisarIniciarExpotacaoTempo;
    private bool AvisarSucessoExpotacaoTempo { get; set; } = padraoAvisarSucessoExpotacaoTempo;

    private bool AvisarIniciarCriacaoPonto { get; set; } = padraoAvisarIniciarCriacaoPonto;
    private bool AvisarSucessoCriacaoPonto { get; set; } = padraoAvisarSucessoCriacaoPonto;
    private bool AvisarIniciarExclusaoPonto { get; set; } = padraoAvisarIniciarExclusaoPonto;
    private bool AvisarSucessoExclusaoPonto { get; set; } = padraoAvisarSucessoExclusaoPonto;
    private bool AvisarIniciarEdicaoPonto { get; set; } = padraoAvisarIniciarEdicaoPonto;
    private bool AvisarSucessoEdicaoPonto { get; set; } = padraoAvisarSucessoEdicaoPonto;

    private bool AvisarIniciarCriacaoCronometro { get; set; } = padraoAvisarIniciarCriacaoCronometro;
    private bool AvisarSucessoCriacaoCronometro { get; set; } = padraoAvisarSucessoCriacaoCronometro;
    private bool AvisarIniciarExclusaoCronometro { get; set; } = padraoAvisarIniciarExclusaoCronometro;
    private bool AvisarSucessoExclusaoCronometro { get; set; } = padraoAvisarSucessoExclusaoCronometro;
    private bool AvisarIniciarEdicaoCronometro { get; set; } = padraoAvisarIniciarEdicaoCronometro;
    private bool AvisarSucessoEdicaoCronometro { get; set; } = padraoAvisarSucessoEdicaoCronometro;
    private bool AvisarIniciarAbandonoCronometro { get; set; } = padraoAvisarIniciarAbandonoCronometro;
    private bool AvisarSucessoAbandonoCronometro { get; set; } = padraoAvisarSucessoAbandonoCronometro;
    private bool AvisarIniciarFinalizacaoCronometro { get; set; } = padraoAvisarIniciarFinalizacaoCronometro;
    private bool AvisarSucessoFinalizacaoCronometro { get; set; } = padraoAvisarSucessoFinalizacaoCronometro;
    #endregion

    #region Botão Restaurar padrões
    private void RestauraPadroes()
    {
        AvisarFecharPrograma = padraoAvisarFecharPrograma;
        AvisarIniciarExpotacaoPonto = padraoAvisarIniciarExpotacaoPonto;
        AvisarSucessoExpotacaoPonto = padraoAvisarSucessoExpotacaoPonto;
        AvisarIniciarExpotacaoTempo = padraoAvisarIniciarExpotacaoTempo;
        AvisarSucessoExpotacaoTempo = padraoAvisarSucessoExpotacaoTempo;
        AvisarIniciarCriacaoPonto = padraoAvisarIniciarCriacaoPonto;
        AvisarSucessoCriacaoPonto = padraoAvisarSucessoCriacaoPonto;
