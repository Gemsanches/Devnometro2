@using Devnometro.Dominio
@using Devnometro.Aplicacao
@inherits ComunicacaoBase

<MudPaper Class="pa-0 ma-3" Elevation="3" MaxWidth="575px">
    <MudExpansionPanel Class="pa-0 mx-0 mb-n4" Dense="true">
        <TitleContent>
            <MudText Typo="Typo.h6" Class="pa-0 mx-n3 mt-n5 pointer-events-none" Color="Color.Dark">Exibir mensagens de confirmação</MudText>
            <MudDivider />
        </TitleContent>
        <ChildContent>
            <MudGrid>
                <MudItem xl="5" lg="5" md="5" sm="5">
                    <MudButton Color="Color.Dark" OnClick="() => {MarcaTudo(true);}" Class="pt-1 pb-0 px-3 mb-0 mt-n4" style="display:block;">Marcar todos</MudButton>
                    <MudButton Color="Color.Dark" OnClick="() => {MarcaConfirmacoes(true);}" Class="pt-1 pb-0 px-3 mx-0" style="display:block">Marcar confirmações</MudButton>
                    <MudButton Color="Color.Dark" OnClick="() => {MarcaAvisos(true);}" Class="pt-1 pb-0 px-3 mt-0 mb-n3" style="display:block">Marcar alertas</MudButton>
                </MudItem>
                <MudItem xl="7" lg="7" md="7" sm="7">
                    <MudButton Color="Color.Dark" OnClick="() => {MarcaTudo(false);}" Class="pt-1 pb-0 px-3 mb-0 mt-n4" style="display:block">Desmarcar todos</MudButton>
                    <MudButton Color="Color.Dark" OnClick="() => {MarcaConfirmacoes(false);}" Class="pt-1 pb-0 px-3 mx-0" style="display:block">Desmarcar confirmações</MudButton>
                    <MudButton Color="Color.Dark" OnClick="() => {MarcaAvisos(false);}" Class="pt-1 pb-0 px-3 mt-0 mb-n3" style="display:block">Desmarcar alertas</MudButton>
                </MudItem>
            </MudGrid>
            <MudDivider Class="mt-3 mb-5" />
        </ChildContent>
    </MudExpansionPanel>
    <MudDivider />
    <MudPaper Elevation="0" Class="d-inline mx-20 py-0 px-n4 my-n4">&#160 &#160 &#160 &#160</MudPaper>
    <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Bottom" >
        <ChildContent>
            <MudCheckBox @bind-Value="Preferencias.Comunicacao.AvisarFecharPrograma" Class="py-0 mt-n3 my-n2" Label="Ao fechar o programa"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Exibir uma mensagem de confirmação</MudText>
            <MudText Typo="Typo.body2">antes de fechar o programa.</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão: </MudText>
            <MudText Typo="Typo.overline" Style="display:inline">@MetodosEstaticos.BooleanoSimNao(PrefereciaPadrao.AvisarFecharPrograma)</MudText>
        </TooltipContent>
    </MudTooltip>
