<MudDivider Class="my-3" />

<MudButton Class="ma-3 px-3 py-1"
Style="float:right"
Variant="Variant.Filled"
Color="Color.Secondary"
OnClick="RestauraPadroes"
Disabled="EstaNosPadroes"
StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
IconColor="Color.Dark">
    Restaurar padrões
</MudButton>

@code {
    private bool AvisarFecharPrograma { get; set; } = false;

    private bool AvisarIniciarExpotacaoPonto { get; set; } = false;
    private bool AvisarSucessoExpotacaoPonto { get; set; } = true;
    private bool AvisarIniciarExpotacaoTempo { get; set; } = false;
    private bool AvisarSucessoExpotacaoTempo { get; set; } = true;

    private bool AvisarIniciarCriacaoPonto { get; set; } = false;
    private bool AvisarSucessoCriacaoPonto { get; set; } = false;
    private bool AvisarIniciarExclusaoPonto { get; set; } = true;
    private bool AvisarSucessoExclusaoPonto { get; set; } = true;
    private bool AvisarIniciarEdicaoPonto { get; set; } = false;
    private bool AvisarSucessoEdicaoPonto { get; set; } = false;

    private bool AvisarIniciarCriacaoCronometro { get; set; } = false;
    private bool AvisarSucessoCriacaoCronometro { get; set; } = false;
    private bool AvisarIniciarExclusaoCronometro { get; set; } = false;
    private bool AvisarSucessoExclusaoCronometro { get; set; } = false;
    private bool AvisarIniciarEdicaoCronometro { get; set; } = false;
    private bool AvisarSucessoEdicaoCronometro { get; set; } = false;
    private bool AvisarIniciarAbandonoCronometro { get; set; } = true;
    private bool AvisarSucessoAbandonoCronometro { get; set; } = false;
    private bool AvisarIniciarFinalizacaoCronometro { get; set; } = false;
    private bool AvisarSucessoFinalizacaoCronometro { get; set; } = false;

    private void RestauraPadroes()
    {
        AvisarFecharPrograma = false;
        AvisarIniciarExpotacaoPonto = false;
        AvisarSucessoExpotacaoPonto = true;
        AvisarIniciarExpotacaoTempo = false;
        AvisarSucessoExpotacaoTempo = true;
        AvisarIniciarCriacaoPonto = false;
        AvisarSucessoCriacaoPonto = false;
        AvisarIniciarExclusaoPonto = true;
        AvisarSucessoExclusaoPonto = true;
        AvisarIniciarEdicaoPonto = false;
        AvisarSucessoEdicaoPonto = false;
        AvisarIniciarCriacaoCronometro = false;
        AvisarSucessoCriacaoCronometro = false;
        AvisarIniciarExclusaoCronometro = false;
        AvisarSucessoExclusaoCronometro = false;
        AvisarIniciarEdicaoCronometro = false;
        AvisarSucessoEdicaoCronometro = false;
        AvisarIniciarAbandonoCronometro = true;
        AvisarSucessoAbandonoCronometro = false;
        AvisarIniciarFinalizacaoCronometro = false;
        AvisarSucessoFinalizacaoCronometro = false;
    }
    private bool EstaNosPadroes
    {
        get
        {
            return !(AvisarFecharPrograma
                  ||  AvisarIniciarExpotacaoPonto
                  || !AvisarSucessoExpotacaoPonto
                  ||  AvisarIniciarExpotacaoTempo
                  || !AvisarSucessoExpotacaoTempo
                  ||  AvisarIniciarCriacaoPonto
                  ||  AvisarSucessoCriacaoPonto
                  || !AvisarIniciarExclusaoPonto
                  || !AvisarSucessoExclusaoPonto
                  ||  AvisarIniciarEdicaoPonto
                  ||  AvisarSucessoEdicaoPonto
                  ||  AvisarIniciarCriacaoCronometro
                  ||  AvisarSucessoCriacaoCronometro
                  ||  AvisarIniciarExclusaoCronometro
                  ||  AvisarSucessoExclusaoCronometro
                  ||  AvisarIniciarEdicaoCronometro
                  ||  AvisarSucessoEdicaoCronometro
                  || !AvisarIniciarAbandonoCronometro
                  ||  AvisarSucessoAbandonoCronometro
                  ||  AvisarIniciarFinalizacaoCronometro
                  ||  AvisarSucessoFinalizacaoCronometro);
        }
    }

    private void MarcaAvisos(bool marca)
    {
        AvisarFecharPrograma = marca;
        AvisarIniciarExpotacaoPonto = marca;
        AvisarIniciarExpotacaoTempo = marca;
        AvisarIniciarCriacaoPonto = marca;
        AvisarIniciarExclusaoPonto = marca;
        AvisarIniciarEdicaoPonto = marca;
        AvisarIniciarCriacaoCronometro = marca;
        AvisarIniciarExclusaoCronometro = marca;
        AvisarIniciarEdicaoCronometro = marca;
        AvisarIniciarAbandonoCronometro = marca;
        AvisarIniciarFinalizacaoCronometro = marca;
    }
    private void MarcaConfirmacoes(bool marca)
    {
        AvisarSucessoExpotacaoPonto = marca;
        AvisarSucessoExpotacaoTempo = marca;
        AvisarSucessoCriacaoPonto = marca;
        AvisarSucessoExclusaoPonto = marca;
        AvisarSucessoEdicaoPonto = marca;
        AvisarSucessoCriacaoCronometro = marca;
        AvisarSucessoExclusaoCronometro = marca;
        AvisarSucessoEdicaoCronometro = marca;
        AvisarSucessoAbandonoCronometro = marca;
        AvisarSucessoFinalizacaoCronometro = marca;
    }
    private void MarcaTudo(bool marca)
    {
        MarcaAvisos(marca);
        MarcaConfirmacoes(marca);
    }

}
