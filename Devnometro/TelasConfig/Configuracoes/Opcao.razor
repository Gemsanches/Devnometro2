<MudPaper Class="pa-0 ma-3" Elevation="3" MaxWidth="575px">
    <MudText Typo="Typo.h6" Class="pa-0 mx-3" Color="Color.Dark">Geral</MudText>
    <MudDivider />
    <MudTooltip Delay="1000" Duration="2000" Placement="Placement.Bottom" Color="Color.Info" Class="ml-20">
        <ChildContent>
            <MudCheckBox @bind-Value="LigarJunto" Class="my-n2" Label="Ligar junto do computador"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Tentar registrar o Devnômetro para ligar</MudText>
            <MudText Typo="Typo.body2">automáticamente com o computador</MudText>
            <MudText Typo="Typo.body2">(dependente do Sistema Operacional)</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline"> Não</MudText>
        </TooltipContent>
    </MudTooltip>
    <MudDivider Class="mb-1" />
    <MudTooltip Delay="1000" Duration="2000" Placement="Placement.Bottom" Color="Color.Info" Class="ml-20">
        <ChildContent>
            <MudGrid>
                <MudItem xl="2" lg="2" md="2" sm="2">
                    <MudText Class="pa-0 mx-3" Typo="Typo.subtitle1" Color="Color.Dark">Exibição</MudText>
                </MudItem>
                <MudItem xl="10" lg="10" md="10" sm="10">
                    <MudRadioGroup Class="mb-1" @bind-Value="Exibicao">
                        <MudRadio Value=1 Color="Color.Primary" Size="Size.Small" Dense="true">Compacta</MudRadio>
                        <MudRadio Value=2 Color="Color.Primary" Size="Size.Small" Dense="true">Normal</MudRadio>
                        <MudRadio Value=3 Color="Color.Primary" Size="Size.Small" Dense="true">Expandida</MudRadio>
                        <MudRadio Value=4 Color="Color.Primary" Size="Size.Small" Dense="true">Legendada</MudRadio>
                    </MudRadioGroup>
                </MudItem>
            </MudGrid>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Regula a quantidade de informação</MudText>
            <MudText Typo="Typo.body2">a ser exibida nos cronômetros</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline"> Normal</MudText>
        </TooltipContent>
    </MudTooltip>
</MudPaper>
<MudPaper Class="pa-0 ma-3" Elevation="3" MaxWidth="575px">
    <MudText Typo="Typo.h6" Class="pa-0 mx-3" Color="Color.Dark">Ponto</MudText>
    <MudDivider />
    <MudTooltip Delay="1000" Duration="2000" Placement="Placement.Bottom" Color="Color.Info" Class="ml-20">
        <ChildContent>
            <MudCheckBox @bind-Value="PrimeiroPontoAutomatico" Class="my-n2" Label="Registrar o primeiro ponto do dia automaticamente"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Ao abrir o Devnômetro, se não houver</MudText>
            <MudText Typo="Typo.body2">nenhum registro de ponto para o dia,</MudText>
            <MudText Typo="Typo.body2">criar o registro da primeira entrada.</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline"> Não</MudText>
        </TooltipContent>
    </MudTooltip>
    <MudDivider />
    <MudTooltip Delay="1000" Duration="2000" Placement="Placement.Bottom" Color="Color.Info" Class="ml-20">
        <ChildContent>
            <MudCheckBox @bind-Value="AutoExportarComecoDoMes" Class="my-n2" Label="Auto exportar os pontos no começo do mês"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Ao abrir o Devnômetro na primeira</MudText>
            <MudText Typo="Typo.body2">segunda-feira do mês, uma exportação</MudText>
            <MudText Typo="Typo.body2">dos pontos do mês anterior será feita.</MudText>
            <MudText Typo="Typo.body2">(caminho de exportação precisa estar</MudText>
            <MudText Typo="Typo.body2">configurado para essa opção funcionar)</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline"> Sim</MudText>
        </TooltipContent>
    </MudTooltip>
</MudPaper>
<MudPaper Class="pa-0 ma-3" Elevation="3" MaxWidth="575px">
    <MudText Typo="Typo.h6" Class="pa-0 mx-3" Color="Color.Dark">Cronômetro</MudText>
    <MudDivider />
    <MudTooltip Delay="1000" Duration="2000" Placement="Placement.Bottom" Color="Color.Info" Class="ml-20">
        <ChildContent>
            <MudCheckBox @bind-Value="ApenasUmAtivo" Class="my-n2" Label="Apenas um cronômetro ativo por vez"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Ao iniciar um cronômetro, os demais</MudText>
            <MudText Typo="Typo.body2">cronomêtros abertos são interrompidos.</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline"> Sim</MudText>
        </TooltipContent>
    </MudTooltip>
    <MudDivider />
    <MudTooltip Delay="1000" Duration="2000" Placement="Placement.Bottom" Color="Color.Info" Class="ml-20">
        <ChildContent>
            <MudCheckBox @bind-Value="ExcluirAutomaticamente" Class="my-n2" Label="Excluir cronômetro automaticamente"></MudCheckBox>
        </ChildContent>
        <TooltipContent>
            <MudText Typo="Typo.body2">Ao abandonar ou finalizar um cronômetro,</MudText>
            <MudText Typo="Typo.body2">ele será excluído automaticamente.</MudText>
            <MudText Typo="Typo.button" Style="display:inline"> Valor Padrão:</MudText>
            <MudText Typo="Typo.overline" Style="display:inline"> Sim</MudText>
        </TooltipContent>
    </MudTooltip>
</MudPaper>
<MudDivider Class="my-3" />
<MudButton Class="ma-3 px-3 py-1"
Style="float:right"
Variant="Variant.Filled"
Color="Color.Secondary"
OnClick="RestauraPadroes"
Disabled="EstaNosPadroes"
StartIcon="@Icons.Material.Filled.SettingsBackupRestore"
IconColor="Color.Dark">
    Restaurar padrões
</MudButton>

@code {
    protected int Exibicao { get; set; } = 2;

    protected bool LigarJunto { get; set; } = false;
    protected bool PrimeiroPontoAutomatico { get; set; } = false;
    protected bool AutoExportarComecoDoMes { get; set; } = true;
    protected bool ExcluirAutomaticamente { get; set; } = true;
    protected bool ApenasUmAtivo { get; set; } = true;

    protected void RestauraPadroes()
    {
        Exibicao = 2;
        LigarJunto = false;
        PrimeiroPontoAutomatico = false;
        AutoExportarComecoDoMes = true;
        ExcluirAutomaticamente = true;
        ApenasUmAtivo = true;
    }

    protected bool EstaNosPadroes
    {
        get
        {
            return Exibicao == 2
                && LigarJunto == false
                && PrimeiroPontoAutomatico == false
                && AutoExportarComecoDoMes == true
                && ExcluirAutomaticamente == true
                && ApenasUmAtivo == true;
        }
    }
}
