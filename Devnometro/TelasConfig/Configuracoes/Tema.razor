@using Devnometro.Dominio
@using Dominio.Enumeradores
@inherits TemaBase

<MudThemeProvider @bind-IsDarkMode="@Preferencias.TemaNoturno" Theme="@Preferencias.Tema" />

<style>
    .cor-clara {
        margin-left: 1px;
        width: 36px;
        height: 20px;
        border-right: 1px solid black;
        display: inline-block;
    }

    .cor-escura {
        margin-right: 1px;
        width: 36px;
        height: 20px;
        border-left: 1px solid black;
        display: inline-block;
    }
</style>

<MudPaper Class="pa-3 ma-3 pointer-events-none " Elevation="3" MaxWidth="575px" Style="background-color:#F5F0FF">
    <MudText Color="Color.Dark" Class="pointer-events-none">Tema atual</MudText>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Primary">1°</MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Secondary">2°</MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Tertiary">3°</MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Info">Info</MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Warning">Aviso</MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Error">Erro</MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Success">Ok</MudButton>
    <MudButton Variant="Variant.Filled" Size="Size.Small" Ripple="false" Class="cursor-default py-1" Color="Color.Surface">Fundo</MudButton>
</MudPaper>
<MudPaper Class="px-3 mx-3 py-1 my-0" Elevation="3" MaxWidth="575px">
    <MudSwitch @bind-Value="Preferencias.TemaNoturno"
               Size="Size.Large"
               ThumbIcon="@(Preferencias.TemaNoturno==true ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
               ThumbIconColor="@(Preferencias.TemaNoturno==true ? Color.Dark : Color.Warning)">Modo Claro/Escuro</MudSwitch>
</MudPaper>

<MudPaper Class="pa-3 ma-3" Elevation="3" MaxWidth="575px">
    <MudGrid>
        <MudItem xl="1" lg="1" md="1" sm="1">
            <MudRadioGroup T="ETema" @bind-Value="Preferencias.TemaSelecionado">
                <MudRadio Value="ETema.TemaPadrao" Color="Color.Dark" Size="Size.Large" Class="my-1" />
                <MudDivider />
                <MudRadio Value="ETema.TemaMudBlazor" Color="Color.Dark" Size="Size.Large" Class="my-2" />
                <MudDivider />
                <MudRadio Value="ETema.TemaTeal" Color="Color.Dark" Size="Size.Large" Class="my-1" />
                <MudDivider />
                <MudRadio Value="ETema.TemaPersonalizado" Color="Color.Dark" Size="Size.Large" Class="mt-2 mb-n1" />
            </MudRadioGroup>
        </MudItem>
        <MudItem xl="11" lg="11" md="11" sm="11">
            <MudPaper Class="pa-2 ma-0 mb-1 pointer-events-none " Elevation="2" Width="500px" Style="background-color:#F5F0FF">
                <MudGrid>
                    <MudItem xl="4" lg="4" md="4" sm="4">
                        <MudText Class="pt-2 pointer-events-none " Typo="Typo.h6" Color="Color.Dark">Padrão</MudText>
                    </MudItem>
                    <MudItem xl="8" lg="8" md="8" sm="8">
                        <div class="cor-clara" style="background-color: #6e7a73;" /><div class="cor-escura" style="background-color: #2e4045;" />@*Primary*@
                        <div class="cor-clara" style="background-color: #bfb5b2;" /><div class="cor-escura" style="background-color: #5e3c58;" />@*Secondary*@
                        <div class="cor-clara" style="background-color: #dab600;" /><div class="cor-escura" style="background-color: #a98600;" />@*Tertiary*@
                        <div class="cor-clara" style="background-color: #54afcd;" /><div class="cor-escura" style="background-color: #359aca;" />@*Info*@
                        <div class="cor-clara" style="background-color: #FF9800;" /><div class="cor-escura" style="background-color: #ffa800;" />@*Warning*@
                        <div class="cor-clara" style="background-color: #bf0000;" /><div class="cor-escura" style="background-color: #800000;" />@*Error*@
                        <div class="cor-clara" style="background-color: #77ab59;" /><div class="cor-escura" style="background-color: #36802d;" />@*Success*@
                        <div class="cor-clara" style="background-color: #F3F3FF;" /><div class="cor-escura" style="background-color: #838996;" />@*Surface*@
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudPaper Class="pa-2 ma-0 mb-1 pointer-events-none " Elevation="2" Width="500px" Style="background-color:#F5F0FF">
                <MudGrid>
                    <MudItem xl="4" lg="4" md="4" sm="4">
                        <MudText Class="pt-2 pointer-events-none " Typo="Typo.h6" Color="Color.Dark">MudBlazor</MudText>
                    </MudItem>
                    <MudItem xl="8" lg="8" md="8" sm="8">
                        <div class="cor-clara" style="background-color: #594AE2;" /><div class="cor-escura" style="background-color: #776be7;" />@*Primary*@
                        <div class="cor-clara" style="background-color: #FF4081;" /><div class="cor-escura" style="background-color: #FF4081;" />@*Secondary*@
                        <div class="cor-clara" style="background-color: #1EC8A5;" /><div class="cor-escura" style="background-color: #1EC8A5;" />@*Tertiary*@
                        <div class="cor-clara" style="background-color: #2196F3;" /><div class="cor-escura" style="background-color: #3299ff;" />@*Info*@
                        <div class="cor-clara" style="background-color: #FF9800;" /><div class="cor-escura" style="background-color: #ffa800;" />@*Warning*@
                        <div class="cor-clara" style="background-color: #F44336;" /><div class="cor-escura" style="background-color: #f64e62;" />@*Error*@
                        <div class="cor-clara" style="background-color: #00C853;" /><div class="cor-escura" style="background-color: #0bba83;" />@*Success*@
                        <div class="cor-clara" style="background-color: #FFFFFF;" /><div class="cor-escura" style="background-color: #373740;" />@*Surface*@
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudPaper Class="pa-2 ma-0 mb-1 pointer-events-none " Elevation="2" Width="500px" Style="background-color:#F5F0FF">
                <MudGrid>
                    <MudItem xl="4" lg="4" md="4" sm="4">
                        <MudText Class="pt-2 pointer-events-none " Typo="Typo.h6" Color="Color.Dark">Teal Deal</MudText>
                    </MudItem>
                    <MudItem xl="8" lg="8" md="8" sm="8">
                        <div class="cor-clara" style="background-color: #006666;" /><div class="cor-escura" style="background-color: #004c4c;" />@*Primary*@
                        <div class="cor-clara" style="background-color: #008080;" /><div class="cor-escura" style="background-color: #006666;" />@*Secondary*@
                        <div class="cor-clara" style="background-color: #66b2b2;" /><div class="cor-escura" style="background-color: #008080;" />@*Tertiary*@
                        <div class="cor-clara" style="background-color: #b2d8d8;" /><div class="cor-escura" style="background-color: #66b2b2;" />@*Info*@
                        <div class="cor-clara" style="background-color: #949406;" /><div class="cor-escura" style="background-color: #949406;" />@*Warning*@
                        <div class="cor-clara" style="background-color: #945306;" /><div class="cor-escura" style="background-color: #942206;" />@*Error*@
                        <div class="cor-clara" style="background-color: #09DE4C;" /><div class="cor-escura" style="background-color: #07A872;" />@*Success*@
                        <div class="cor-clara" style="background-color: #F3FFFF;" /><div class="cor-escura" style="background-color: #718E8B;" />@*Surface*@
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudPaper Class="pa-2 ma-0" Elevation="2" Width="500px" Style="background-color:#F5F0FF">
                <MudGrid>
                    <MudItem xl="4" lg="4" md="4" sm="4">
                        <MudText Class="pt-2 pointer-events-none " Typo="Typo.body2" Color="Color.Dark">Tema Personalizado</MudText>
                        <MudPaper Square="true" Class="d-flex justify-space-around">
                            <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Top" Class="ml-20">
                                <ChildContent>
                                    <MudIcon Class="ml-1 cursor-pointer" Style="font-size: 20px;" Icon="@Icons.Material.Filled.Save" @onclick="Preferencias.TemaPersonalizado.AplicarCoresAoTema" />
                                </ChildContent>
                                <TooltipContent>
                                    <MudText Typo="Typo.body2">Salvar tema personalizado</MudText>
                                </TooltipContent>
                            </MudTooltip>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Top" Class="ml-20">
                                <ChildContent>
                                    <MudIcon Class="cursor-pointer" Style="font-size: 20px;" Icon="@Icons.Material.Filled.FileDownload" @onclick="AplicarTemaImportado" />
                                </ChildContent>
                                <TooltipContent>
                                    <MudText Typo="Typo.body2">Importar tema personalizado</MudText>
                                </TooltipContent>
                            </MudTooltip>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Top" Class="ml-20">
                                <ChildContent>
                                    <MudIcon Class="cursor-pointer" Style="font-size: 20px;" Icon="@Icons.Material.Filled.FileUpload" @onclick="() => Manipulador.ExportarTemaPersonalizado(Preferencias.TemaPersonalizado)" />
                                </ChildContent>
                                <TooltipContent>
                                    <MudText Typo="Typo.body2">Exportar tema personalizado</MudText>
                                </TooltipContent>
                            </MudTooltip>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudTooltip Delay=@TooltipPadrao.delay Duration=@TooltipPadrao.duration Color=@TooltipPadrao.corTolltip Placement="Placement.Top" Class="ml-20">
                                <ChildContent>
                                    <MudIcon Class="mr-1 cursor-pointer" Style="font-size: 20px;" Icon="@Icons.Material.Filled.SettingsBackupRestore" @onclick="Preferencias.TemaPersonalizado.RetornarAoPadrao" />
                                </ChildContent>
                                <TooltipContent>
                                    <MudText Typo="Typo.body2">Restaurar cores ao último tema personalizado salvo</MudText>
                                </TooltipContent>
                            </MudTooltip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xl="8" lg="8" md="8" sm="8">

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.PrimaryLight" Style='@($"color:{Preferencias.TemaPersonalizado.PrimaryLight}; background-color:{Preferencias.TemaPersonalizado.PrimaryLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.PrimaryDark" Style='@($"color:{Preferencias.TemaPersonalizado.PrimaryDark}; background-color:{Preferencias.TemaPersonalizado.PrimaryDark};font-size:6.3px")' />

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.SecondaryLight" Style='@($"color:{Preferencias.TemaPersonalizado.SecondaryLight}; background-color:{Preferencias.TemaPersonalizado.SecondaryLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.SecondaryDark" Style='@($"color:{Preferencias.TemaPersonalizado.SecondaryDark}; background-color:{Preferencias.TemaPersonalizado.SecondaryDark};font-size:6.3px")' />

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.TertiaryLight" Style='@($"color:{Preferencias.TemaPersonalizado.TertiaryLight}; background-color:{Preferencias.TemaPersonalizado.TertiaryLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.TertiaryDark" Style='@($"color:{Preferencias.TemaPersonalizado.TertiaryDark}; background-color:{Preferencias.TemaPersonalizado.TertiaryDark};font-size:6.3px")' />

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.InfoLight" Style='@($"color:{Preferencias.TemaPersonalizado.InfoLight}; background-color:{Preferencias.TemaPersonalizado.InfoLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.InfoDark" Style='@($"color:{Preferencias.TemaPersonalizado.InfoDark}; background-color:{Preferencias.TemaPersonalizado.InfoDark};font-size:6.3px")' />

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.WarningLight" Style='@($"color:{Preferencias.TemaPersonalizado.WarningLight}; background-color:{Preferencias.TemaPersonalizado.WarningLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.WarningDark" Style='@($"color:{Preferencias.TemaPersonalizado.WarningDark}; background-color:{Preferencias.TemaPersonalizado.WarningDark};font-size:6.3px")' />

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.ErrorLight" Style='@($"color:{Preferencias.TemaPersonalizado.ErrorLight}; background-color:{Preferencias.TemaPersonalizado.ErrorLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.ErrorDark" Style='@($"color:{Preferencias.TemaPersonalizado.ErrorDark}; background-color:{Preferencias.TemaPersonalizado.ErrorDark};font-size:6.3px")' />

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.SuccessLight" Style='@($"color:{Preferencias.TemaPersonalizado.SuccessLight}; background-color:{Preferencias.TemaPersonalizado.SuccessLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.SuccessDark" Style='@($"color:{Preferencias.TemaPersonalizado.SuccessDark}; background-color:{Preferencias.TemaPersonalizado.SuccessDark};font-size:6.3px")' />

                        <MudColorPicker Class="cor-clara mr-n1" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.SurfaceLight" Style='@($"color:{Preferencias.TemaPersonalizado.SurfaceLight}; background-color:{Preferencias.TemaPersonalizado.SurfaceLight};font-size:6.3px")' />
                        <MudColorPicker Class="cor-escura" AdornmentIcon="" ColorPickerView="ColorPickerView.GridCompact" @bind-Text="Preferencias.TemaPersonalizado.SurfaceDark" Style='@($"color:{Preferencias.TemaPersonalizado.SurfaceDark}; background-color:{Preferencias.TemaPersonalizado.SurfaceDark};font-size:6.3px")' />

                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudPaper>
