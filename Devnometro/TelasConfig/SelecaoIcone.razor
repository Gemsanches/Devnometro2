                            <MudToggleIconButton @bind-Toggled="categoria4" Color="@Color.Error" ToggledColor="@Color.Success" Size="Size.Large" Icon="@Icons.Material.Filled.ReportOff" ToggledIcon="@Icons.Material.Filled.Report" />
                        </MudPaper>
                    </MudBadge>
                </MudStack>
            </MudPaper>
        </MudStack>
