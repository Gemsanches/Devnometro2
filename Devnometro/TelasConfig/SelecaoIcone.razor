@using Devnometro.Dominio
@using Devnometro.Dominio.Enumeradores
<MudDialog Class="pa-0 mud-theme-secondary" Style="width:600px; height:500px;">
    <TitleContent>
        <MudStack Row="true">
            <MudPaper Elevation="0" Width="385px" Height="30px" Class="mud-theme-secondary">
                <MudText Class="pa-0 pointer-events-none" Typo="Typo.h6" Style="height:25px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" Color="Color.Dark">@descricaoExibicao</MudText>
            </MudPaper>
            <MudPaper Elevation="0" Width="155px" Height="30px" Class="mud-theme-secondary">
                <MudStack Row="true">
                    <MudButton Variant="Variant.Filled" OnClick="Confirma" Size="Size.Small" Color="Color.Success">OK</MudButton>
                    <MudButton Variant="Variant.Filled" OnClick="Cancela" Size="Size.Small" Color="Color.Error" Class="px-5">Cancela</MudButton>
                </MudStack>
            </MudPaper>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Row="true">
            <MudPaper Elevation="2" Width="80px" Height="80px">
                <MudIcon Icon=@iconeExibição Color=@corExibicao Style="font-size: 80px;" />
            </MudPaper>
            <MudPaper Elevation="2" Class="pa-3 cursor-default mud-theme-primary" Width="460px" Height="80px">
                <MudStack Row="true">
                    <MudBadge Icon="@Icons.Material.Rounded.Palette" Color="Color.Primary" Overlap="true" Bordered="true" Class="pa-0 ma-0">
                        <MudPaper Elevation="1" Class="pa-1" Width="85px" Height="56px">
                            <div @onclick="(()=>SetCor(Color.Dark))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Dark" /></div>
                            <div @onclick="(()=>SetCor(Color.Primary))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Primary" /></div>
                            <div @onclick="(()=>SetCor(Color.Secondary))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Secondary" /></div>
                            <div @onclick="(()=>SetCor(Color.Tertiary))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Tertiary" /></div>
                            <div @onclick="(()=>SetCor(Color.Info))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Info" /></div>
                            <div @onclick="(()=>SetCor(Color.Warning))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Warning" /></div>
                            <div @onclick="(()=>SetCor(Color.Error))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Error" /></div>
                            <div @onclick="(()=>SetCor(Color.Success))" style="display: inline-block; width: 15px; height: 15px; cursor: pointer;"><MudIcon Icon=@Icons.Material.Filled.Square Style="font-size: 20px;" Color="Color.Success" /></div>
                        </MudPaper>
                    </MudBadge>
                    <MudBadge Icon="@Icons.Material.Rounded.KeyboardBackspace" Color="Color.Primary" Overlap="true" Bordered="true" Class="pa-0 ma-0">
                        <MudPaper Elevation="1" Class="d-flex align-content-center justify-center" Width="56px" Height="56px">
