@code {
    private const string descricaoPadrao = "Seleção de Ícone";
    private const string iconePadrao = @Icons.Material.Filled.QuestionMark;
    private const Color corPadrao = Color.Dark;

    [CascadingParameter] public required MudDialogInstance Dialog { get; set; }
    [Parameter] public required Dominio.IconeDados Dados { get; set; }

    private string descricaoExibicao = null!;
    private string iconeExibição = "";
    private string iconeAnterior = "";
    private Color corExibicao = corPadrao;
    private Color corAnterior = corPadrao;

    private bool categoria1 = true;
    private bool categoria2 = true;
    private bool categoria3 = true;
    private bool categoria4 = true;

    protected override void OnInitialized()
    {
        descricaoExibicao = string.IsNullOrWhiteSpace(Dados.Nome) ? descricaoPadrao : Dados.Nome;
        iconeExibição = string.IsNullOrEmpty(Dados.Icone) ? iconePadrao : Dados.Icone;
        iconeAnterior = string.IsNullOrEmpty(Dados.Icone) ? iconePadrao : Dados.Icone;
        corExibicao = Dados.Cor;
        corAnterior = Dados.Cor;
    }

    private void SetCor(Color cor)
    {
        if (corExibicao == cor) return;
        corExibicao = cor;
        StateHasChanged();
    }

    private void SetIcone(string icone)
    {
        if (iconeExibição == icone) return;
        iconeExibição = icone;
        StateHasChanged();
    }

    private void VoltaIcone()
    {
        iconeExibição = iconeAnterior;
        corExibicao = corAnterior;
        StateHasChanged();
    }

    private void Confirma() => Dialog.Close(new Dominio.IconeDados(cor: corExibicao, icone: iconeExibição));

    private void Cancela() => Dialog.Cancel();
}
